UE" BGCOLOR="white" COLOR="#d0d0d0"></TD></TR><TR><TD WIDTH="11" HEIGHT="11" FIXEDSIZE="TRUE" BGCOLOR="white" COLOR="#d0d0d0"></TD></TR><TR><TD WIDTH="11" HEIGHT="11" FIXEDSIZE="TRUE" BGCOLOR="white" COLOR="#d0d0d0"></TD></TR><TR><TD WIDTH="11" HEIGHT="11" FIXEDSIZE="TRUE" BGCOLOR="white" COLOR="#d0d0d0"></TD></TR><TR><TD WIDTH="11" HEIGHT="11" FIXEDSIZE="TRUE" BGCOLOR="white" COLOR="#d0d0d0"></TD></TR></TABLE></TD><TD BORDER="0" CELLPADDING="2"><TABLE BORDER="2" CELLBORDER="1" CELLSPACING="0" CELLPADDING="0" COLOR="#3d3d3d"><TR><TD WIDTH="11" HEIGHT="11" FIXEDSIZE="TRUE" BGCOLOR="#e8e8e8" COLOR="#b0b0b0"></TD></TR><TR><TD WIDTH="11" HEIGHT="11" FIXEDSIZE="TRUE" BGCOLOR="#e8e8e8" COLOR="#b0b0b0"></TD></TR><TR><TD WIDTH="11" HEIGHT="11" FIXEDSIZE="TRUE" BGCOLOR="white" COLOR="#d0d0d0"></TD></TR><TR><TD WIDTH="11" HEIGHT="11" FIXEDSIZE="TRUE" BGCOLOR="white" COLOR="#d0d0d0"></TD></TR><TR><TD WIDTH="11" HEIGHT="11" FIXEDSIZE="TRUE" BGCOLOR="white" COLOR="#d0d0d0"></TD></TR><TR><TD WIDTH="11" HEIGHT="11" FIXEDSIZE="TRUE" BGCOLOR="white" COLOR="#d0d0d0"></TD></TR><TR><TD WIDTH="11" HEIGHT="11" FIXEDSIZE="TRUE" BGCOLOR="white" COLOR="#d0d0d0"></TD></TR><TR><TD WIDTH="11" HEIGHT="11" FIXEDSIZE="TRUE" BGCOLOR="white" COLOR="#d0d0d0"></TD></TR></TABLE></TD></TR></TABLE>>];
    a2 [shape=box, style="rounded,filled", fillcolor="#7fb0d8", color="#2f5d85", penwidth=1.4, margin="0.14,0.07", label=<accumulator A<SUB>0</SUB><BR/><FONT POINT-SIZE="9">on the r=0 tile</FONT>>];
    p2:t0 -> a2 [color="#2f5d85", style=dotted, arrowhead=none, penwidth=1.0];
    p2:t1 -> a2 [color="#5b8db8", arrowsize=0.5, penwidth=0.9];
    p2:t2 -> a2 [color="#5b8db8", arrowsize=0.5, penwidth=0.9];
    cap2 [label=<<FONT POINT-SIZE="10">48 tiles &#183; network reduction depth <B>ceil(18/8) &#8722; 1 = 2</B></FONT>>];
    a2 -> cap2 [style=invis];
  }
  {rank=same; p0; p1; p2;}
  p0 -> p1 [style=invis]; p1 -> p2 [style=invis];
  label=<<BR/><FONT POINT-SIZE="10.5">ResNet-50 stage-3 conv2 (3&#215;3&#215;256&#8594;256), XB=128, N<SUB>bits</SUB>=8 &#8658; grid = R<SUB>xb</SUB>=<B>18</B> (input axis, k<SUP>2</SUP>C<SUB>in</SUB>) &#215; C<SUB>xb</SUB>=<B>16</B> (output axis, C<SUB>out</SUB>N<SUB>bits</SUB>) = 288 crossbars, packed <B>c=8</B> crossbars/tile in all three.<BR/> <BR ALIGN="CENTER"/>Same grid, same density &#8212; only where the tile boundary falls. Blue = the tiles whose partial sums converge on one accumulator group; dark blue = the r=0 tile, which <B>hosts</B> that accumulator and so sends nothing over the network; hollow cells = allocated but unused (fragmentation).</FONT>>;
  labelloc="b"; labeljust="c";
}
