  "o:2" -> "ff2:2" [color="#f2d024"];
  "q:0" -> "k:0" [color="#555555"];
  "q:0" -> "k:1" [color="#555555"];
  "q:0" -> "k:2" [color="#555555"];
  "q:0" -> "o:0" [color="#555555"];
  "q:0" -> "o:1" [color="#555555"];
  "q:0" -> "o:2" [color="#555555"];
  "q:0" -> "q:1" [color="#555555"];
  "q:0" -> "q:2" [color="#555555"];
  "q:0" -> "v:0" [color="#555555"];
  "q:0" -> "v:1" [color="#555555"];
  "q:0" -> "v:2" [color="#555555"];
  "v:0" -> "o:0" [color="#4a90d9"];
  "v:0" -> "o:1" [color="#4a90d9"];
  "v:0" -> "o:2" [color="#4a90d9"];
  "v:1" -> "o:0" [color="#4a90d9"];
  "v:1" -> "o:1" [color="#4a90d9"];
  "v:1" -> "o:2" [color="#4a90d9"];
  "v:2" -> "o:0" [color="#4a90d9"];
  "v:2" -> "o:1" [color="#4a90d9"];
  "v:2" -> "o:2" [color="#4a90d9"];
}
