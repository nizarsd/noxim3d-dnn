  "o:2" -> "ff1:0" [color="#f2d024"];
  "o:2" -> "ff1:1" [color="#f2d024"];
  "o:2" -> "ff1:2" [color="#f2d024"];
  "o:2" -> "ff1:3" [color="#f2d024"];
  "o:2" -> "ff1:4" [color="#f2d024"];
