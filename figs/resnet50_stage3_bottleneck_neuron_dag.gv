digraph ResNet50Stage3Bottleneck {
  graph [rankdir=LR, splines=true, overlap=false, concentrate=true,
         labelloc="t", fontsize=18, fontname="Arial",
         label="ResNet-50 stage-3 bottleneck — channel-neuron DAG (one spatial position)"];
  node [shape=circle, fixedsize=true, width=0.20, height=0.20, margin=0, fontsize=5, fontname="Arial", style=filled];
  edge [arrowsize=0.35, penwidth=0.35, color=gray55];

