  "conv2:3" -> "conv3:0" [color="#7f8c8d"];
  "conv2:3" -> "conv3:1" [color="#7f8c8d"];
  "conv2:3" -> "conv3:2" [color="#7f8c8d"];
  "conv2:3" -> "conv3:3" [color="#7f8c8d"];
  "conv2:3" -> "conv3:4" [color="#7f8c8d"];
  "conv2:3" -> "conv3:5" [color="#7f8c8d"];
  "conv2:3" -> "conv3:6" [color="#7f8c8d"];
  "conv2:3" -> "conv3:7" [color="#7f8c8d"];
  "conv2:3" -> "conv3:8" [color="#7f8c8d"];
  "conv2:3" -> "conv3:9" [color="#7f8c8d"];
  "conv2:3" -> "conv3:10" [color="#7f8c8d"];
  "conv2:3" -> "conv3:11" [color="#7f8c8d"];
  "conv2:3" -> "conv3:12" [color="#7f8c8d"];
  "conv2:3" -> "conv3:13" [color="#7f8c8d"];
  "conv2:3" -> "conv3:14" [color="#7f8c8d"];
  "conv2:3" -> "conv3:15" [color="#7f8c8d"];
  "shortcut:0" -> "conv3:0" [color="#f2d024"];
  "shortcut:1" -> "conv3:1" [color="#f2d024"];
  "shortcut:2" -> "conv3:2" [color="#f2d024"];
  "shortcut:3" -> "conv3:3" [color="#f2d024"];
  "shortcut:4" -> "conv3:4" [color="#f2d024"];
