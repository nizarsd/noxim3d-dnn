  "conv2:1" -> "conv3:13" [color="#7f8c8d"];
  "conv2:1" -> "conv3:14" [color="#7f8c8d"];
  "conv2:1" -> "conv3:15" [color="#7f8c8d"];
  "conv2:2" -> "conv3:0" [color="#7f8c8d"];
  "conv2:2" -> "conv3:1" [color="#7f8c8d"];
  "conv2:2" -> "conv3:2" [color="#7f8c8d"];
  "conv2:2" -> "conv3:3" [color="#7f8c8d"];
  "conv2:2" -> "conv3:4" [color="#7f8c8d"];
