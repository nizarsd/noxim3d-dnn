digraph clusters {
  rankdir=LR; splines=line; bgcolor="white"; newrank=true;
  graph [margin=0.3,pad=0.25,nodesep=0.16,ranksep=1.5,fontname="Helvetica"];
  node [shape=circle,style=filled,fixedsize=true,width=0.34,label="",penwidth=1.1,color="#333333",fontname="Helvetica"];
  edge [arrowsize=0.45,penwidth=0.7];
  labelloc="t"; fontsize=13; label=<<b>ResNet-50 stage-3 bottleneck</b><br/><font point-size="9">one circle = one reduce cluster (the tiles sharing an accumulator) &#183; arrow = inter-cluster traffic &#183; colour = source layer &#183; volume not encoded</font>>;
  subgraph cluster_key {
    label=""; style="invis";
    "key_0" [shape=plaintext,style="",fixedsize=false,label=<<table border="0" cellborder="0" cellspacing="1"><tr><td><font face="Helvetica" point-size="15" color="#555555">&#9679;</font></td><td align="left"><font face="Helvetica" point-size="10">conv1  (2 tiles per cluster)</font></td></tr></table>>];
    "key_1" [shape=plaintext,style="",fixedsize=false,label=<<table border="0" cellborder="0" cellspacing="1"><tr><td><font face="Helvetica" point-size="15" color="#7f8c8d">&#9679;</font></td><td align="left"><font face="Helvetica" point-size="10">conv2  (9 tiles per cluster)</font></td></tr></table>>];
    "key_0" -> "key_1" [style=invis];
    "key_2" [shape=plaintext,style="",fixedsize=false,label=<<table border="0" cellborder="0" cellspacing="1"><tr><td><font face="Helvetica" point-size="15" color="#4a90d9">&#9679;</font></td><td align="left"><font face="Helvetica" point-size="10">conv3  (1 tile per cluster)</font></td></tr></table>>];
    "key_1" -> "key_2" [style=invis];
    "key_3" [shape=plaintext,style="",fixedsize=false,label=<<table border="0" cellborder="0" cellspacing="1"><tr><td><font face="Helvetica" point-size="15" color="#f2d024">&#9679;</font></td><td align="left"><font face="Helvetica" point-size="10">shortcut  (2 tiles per cluster)</font></td></tr></table>>];
    "key_2" -> "key_3" [style=invis];
  }
  // ---- conv1
  { rank=same; "conv1:0"; "conv1:1"; "conv1:2"; "conv1:3"; }
  "conv1:0" [fillcolor="#ffffff",penwidth=1.6];
  "conv1:1" [fillcolor="#ffffff",penwidth=1.6];
  "conv1:2" [fillcolor="#ffffff",penwidth=1.6];
  "conv1:3" [fillcolor="#ffffff",penwidth=1.6];
  // ---- conv2
  { rank=same; "conv2:0"; "conv2:1"; "conv2:2"; "conv2:3"; }
  "conv2:0" [fillcolor="#7f8c8d",penwidth=1.6];
  "conv2:1" [fillcolor="#7f8c8d",penwidth=1.6];
  "conv2:2" [fillcolor="#7f8c8d",penwidth=1.6];
  "conv2:3" [fillcolor="#7f8c8d",penwidth=1.6];
  // ---- conv3
  { rank=same; "conv3:0"; "conv3:1"; "conv3:2"; "conv3:3"; "conv3:4"; "conv3:5"; "conv3:6"; "conv3:7"; "conv3:8"; "conv3:9"; "conv3:10"; "conv3:11"; "conv3:12"; "conv3:13"; "conv3:14"; "conv3:15"; }
  "conv3:0" [fillcolor="#4a90d9",penwidth=1.6];
  "conv3:1" [fillcolor="#4a90d9",penwidth=1.6];
  "conv3:2" [fillcolor="#4a90d9",penwidth=1.6];
  "conv3:3" [fillcolor="#4a90d9",penwidth=1.6];
  "conv3:4" [fillcolor="#4a90d9",penwidth=1.6];
  "conv3:5" [fillcolor="#4a90d9",penwidth=1.6];
  "conv3:6" [fillcolor="#4a90d9",penwidth=1.6];
  "conv3:7" [fillcolor="#4a90d9",penwidth=1.6];
  "conv3:8" [fillcolor="#4a90d9",penwidth=1.6];
  "conv3:9" [fillcolor="#4a90d9",penwidth=1.6];
  "conv3:10" [fillcolor="#4a90d9",penwidth=1.6];
  "conv3:11" [fillcolor="#4a90d9",penwidth=1.6];
  "conv3:12" [fillcolor="#4a90d9",penwidth=1.6];
  "conv3:13" [fillcolor="#4a90d9",penwidth=1.6];
  "conv3:14" [fillcolor="#4a90d9",penwidth=1.6];
  "conv3:15" [fillcolor="#4a90d9",penwidth=1.6];
  // ---- shortcut
  { rank=same; "shortcut:0"; "shortcut:1"; "shortcut:2"; "shortcut:3"; "shortcut:4"; "shortcut:5"; "shortcut:6"; "shortcut:7"; "shortcut:8"; "shortcut:9"; "shortcut:10"; "shortcut:11"; "shortcut:12"; "shortcut:13"; "shortcut:14"; "shortcut:15"; }
  "shortcut:0" [fillcolor="#f2d024",penwidth=1.6];
  "shortcut:1" [fillcolor="#f2d024",penwidth=1.6];
  "shortcut:2" [fillcolor="#f2d024",penwidth=1.6];
  "shortcut:3" [fillcolor="#f2d024",penwidth=1.6];
  "shortcut:4" [fillcolor="#f2d024",penwidth=1.6];
  "shortcut:5" [fillcolor="#f2d024",penwidth=1.6];
  "shortcut:6" [fillcolor="#f2d024",penwidth=1.6];
  "shortcut:7" [fillcolor="#f2d024",penwidth=1.6];
  "shortcut:8" [fillcolor="#f2d024",penwidth=1.6];
  "shortcut:9" [fillcolor="#f2d024",penwidth=1.6];
  "shortcut:10" [fillcolor="#f2d024",penwidth=1.6];
  "shortcut:11" [fillcolor="#f2d024",penwidth=1.6];
  "shortcut:12" [fillcolor="#f2d024",penwidth=1.6];
  "shortcut:13" [fillcolor="#f2d024",penwidth=1.6];
  "shortcut:14" [fillcolor="#f2d024",penwidth=1.6];
  "shortcut:15" [fillcolor="#f2d024",penwidth=1.6];
  "conv1:0" -> "conv1:1" [color="#555555"];
  "conv1:0" -> "conv1:2" [color="#555555"];
  "conv1:0" -> "conv1:3" [color="#555555"];
  "conv1:0" -> "conv2:0" [color="#555555"];
  "conv1:0" -> "conv2:1" [color="#555555"];
  "conv1:0" -> "conv2:2" [color="#555555"];
  "conv1:0" -> "conv2:3" [color="#555555"];
  "conv1:0" -> "shortcut:0" [color="#555555"];
  "conv1:0" -> "shortcut:1" [color="#555555"];
  "conv1:0" -> "shortcut:2" [color="#555555"];
  "conv1:0" -> "shortcut:3" [color="#555555"];
  "conv1:0" -> "shortcut:4" [color="#555555"];
  "conv1:0" -> "shortcut:5" [color="#555555"];
  "conv1:0" -> "shortcut:6" [color="#555555"];
  "conv1:0" -> "shortcut:7" [color="#555555"];
  "conv1:0" -> "shortcut:8" [color="#555555"];
  "conv1:0" -> "shortcut:9" [color="#555555"];
  "conv1:0" -> "shortcut:10" [color="#555555"];
  "conv1:0" -> "shortcut:11" [color="#555555"];
  "conv1:0" -> "shortcut:12" [color="#555555"];
  "conv1:0" -> "shortcut:13" [color="#555555"];
  "conv1:0" -> "shortcut:14" [color="#555555"];
  "conv1:0" -> "shortcut:15" [color="#555555"];
  "conv1:1" -> "conv2:0" [color="#555555"];
  "conv1:1" -> "conv2:1" [color="#555555"];
  "conv1:1" -> "conv2:2" [color="#555555"];
  "conv1:1" -> "conv2:3" [color="#555555"];
  "conv1:2" -> "conv2:0" [color="#555555"];
  "conv1:2" -> "conv2:1" [color="#555555"];
  "conv1:2" -> "conv2:2" [color="#555555"];
  "conv1:2" -> "conv2:3" [color="#555555"];
  "conv1:3" -> "conv2:0" [color="#555555"];
  "conv1:3" -> "conv2:1" [color="#555555"];
  "conv1:3" -> "conv2:2" [color="#555555"];
  "conv1:3" -> "conv2:3" [color="#555555"];
  "conv2:0" -> "conv3:0" [color="#7f8c8d"];
  "conv2:0" -> "conv3:1" [color="#7f8c8d"];
  "conv2:0" -> "conv3:2" [color="#7f8c8d"];
  "conv2:0" -> "conv3:3" [color="#7f8c8d"];
  "conv2:0" -> "conv3:4" [color="#7f8c8d"];
  "conv2:0" -> "conv3:5" [color="#7f8c8d"];
  "conv2:0" -> "conv3:6" [color="#7f8c8d"];
  "conv2:0" -> "conv3:7" [color="#7f8c8d"];
  "conv2:0" -> "conv3:8" [color="#7f8c8d"];
  "conv2:0" -> "conv3:9" [color="#7f8c8d"];
  "conv2:0" -> "conv3:10" [color="#7f8c8d"];
  "conv2:0" -> "conv3:11" [color="#7f8c8d"];
  "conv2:0" -> "conv3:12" [color="#7f8c8d"];
  "conv2:0" -> "conv3:13" [color="#7f8c8d"];
  "conv2:0" -> "conv3:14" [color="#7f8c8d"];
  "conv2:0" -> "conv3:15" [color="#7f8c8d"];
  "conv2:1" -> "conv3:0" [color="#7f8c8d"];
  "conv2:1" -> "conv3:1" [color="#7f8c8d"];
  "conv2:1" -> "conv3:2" [color="#7f8c8d"];
