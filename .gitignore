# Build artifacts
*.o
*.obj
*.exe
noxim
# A/B binaries built from variant sources (noxim_1x, noxim_ref, noxim_base, ...)
noxim_*

# Secrets -- this repo's origin is PUBLIC. Never commit key material.
gitkeygen.txt
gitkeygen.txt.pub
*.pem
id_rsa
id_rsa.pub
id_ed25519
id_ed25519.pub

# Version control cruft
.svn/

# Windows zone identifier alternate data streams (from downloaded/copied files)
*Zone.Identifier*

# Simulation outputs / result dumps
results/
results_*/
*.ptrace
*.ptrace.old
*.ptrace.temp
*.ptrace.temp.old
*.steady
*.steady.aggrigate
*.steady.aggrigate.fa
*.grid.steady
*.grid.steady.fa
*.init
*.flp.old

# Archives / snapshots -- migration tarballs contain .git AND gitkeygen.txt,
# so never let one be staged into a repo whose origin is public.
*.tar.gz
*.tgz
*.tar
*.zip

# Python bytecode (from converter imports)
__pycache__/
*.pyc

# sweep console logs (regenerable)
*.out
